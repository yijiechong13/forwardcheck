# ForwardCheck configuration template.
#
# Copy to backend/.env and fill in your own values:
#     cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must NEVER be committed.
# This template contains placeholders only — never real keys.
#
# With no .env at all, the app runs fully in mock mode: no network calls,
# no API keys, no cost.

# --- Mode ----------------------------------------------------------------
# mock (default): deterministic pipeline over seeded sample evidence. $0.
# live:           Anthropic decomposition/grading + Tavily search + fetching.
#                 Both keys below are required; startup fails without them.
FORWARDCHECK_MODE=mock

# --- Provider credentials (live mode only) --------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key
TAVILY_API_KEY=your_tavily_api_key

# Smallest suitable model by default; override to trade cost for quality.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Hard per-request budgets --------------------------------------------
# These constrain actual billable provider requests, retries included.
FORWARDCHECK_MAX_CLAIMS=6
FORWARDCHECK_MAX_SEARCH_ROUNDS=2
FORWARDCHECK_MAX_SEARCHES_TOTAL=8
FORWARDCHECK_MAX_SOURCES_PER_CLAIM=3
FORWARDCHECK_MAX_LLM_CALLS_PER_REQUEST=3
FORWARDCHECK_MAX_FETCHES_TOTAL=8
FORWARDCHECK_REQUEST_TIMEOUT_SECONDS=20

# --- Cache TTLs, seconds --------------------------------------------------
# Searches expire soonest, pages last longest, whole results shortest of all
# so a policy change is not masked by a stale verdict.
FORWARDCHECK_CACHE_TTL_SEARCH=21600
FORWARDCHECK_CACHE_TTL_PAGE=172800
FORWARDCHECK_CACHE_TTL_RESULT=1800
# FORWARDCHECK_CACHE_DIR=./.cache

# --- Document chunking ----------------------------------------------------
FORWARDCHECK_CHUNK_MAX_CHARS=1400
FORWARDCHECK_CHUNK_OVERLAP=150

# --- Deterministic (mock) pipeline tuning ---------------------------------
FORWARDCHECK_STALE_DAYS=540
FORWARDCHECK_MIN_SCORE=0.28
FORWARDCHECK_MAX_EVIDENCE=4

# --- API ------------------------------------------------------------------
FORWARDCHECK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

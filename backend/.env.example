# ForwardCheck configuration.
#
# Every value here is OPTIONAL. With no .env file at all, the app runs fully
# mocked and needs no API keys — that is the supported default.

# --- Adapter selection ---
# llm:       mock | anthropic   (anthropic: not implemented, Phase 4 TODO)
# retrieval: mock | pgvector    (pgvector:  not implemented, Phase 4 TODO)
# search:    mock | web         (web:       not implemented, Phase 4 TODO)
FORWARDCHECK_LLM=mock
FORWARDCHECK_RETRIEVAL=mock
FORWARDCHECK_SEARCH=mock

# --- Keys (only needed for the non-mock backends above) ---
# ANTHROPIC_API_KEY=
# SEARCH_API_KEY=
# DATABASE_URL=postgresql://localhost:5432/forwardcheck

# --- Tuning ---
# Evidence older than this is flagged as potentially stale (days).
FORWARDCHECK_STALE_DAYS=540
# Retrieval score below which evidence is discarded rather than graded.
# Higher = more abstention, fewer weakly-grounded verdicts.
FORWARDCHECK_MIN_SCORE=0.28
FORWARDCHECK_MAX_EVIDENCE=4

FORWARDCHECK_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
